# Server Port
PORT=5000

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/campus_lost_found or Atlas URI)
# If empty or unreachable, the server can use an in-memory database for testing
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found

# JWT Secret Key for Token Generation
JWT_SECRET=campus_lost_found_jwt_secret_key_change_in_production_2026

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
