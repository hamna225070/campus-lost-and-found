{
  "name": "campus-lost-found",
  "version": "1.0.0",
  "description": "Campus Lost and Found Portal - Full-stack MERN capstone project",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed:admin": "npm --prefix server run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "mern",
    "lost-and-found",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}
